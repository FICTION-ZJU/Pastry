(GOAL EXPECTEDCOMPLEXITY)
  (STARTTERM (FUNCTIONSYMBOLS s0))
  (VAR start established probe)
  (RULES
    s0(start,established,probe) -> s1(1,0,0)
    s1(start,established,probe) -> s2(start,established,probe) :|: ((start <= 1) && (established <= 0)) && (probe < 4)
    s2(start,established,probe) -> s3(start,established,probe) :|: start > 0
    s2(start,established,probe) -> s4(start,established,probe) :|: start <= 0
    s3(start,established,probe) -> 0.5:s5(0,established,probe) :+: 0.5:s5(0,1,probe)
    s4(start,established,probe) -> 0.001:s5(start,established,probe+1) :+: 0.999:s5(1,established,0)
    s5(start,established,probe) -> s1(start,established,probe)
  )
