(GOAL EXPECTEDCOMPLEXITY)
  (STARTTERM (FUNCTIONSYMBOLS s0))
  (VAR T H)
  (RULES
    s0(T,H) -> s1(1000,0)
    s1(T,H) -> [6/11]:s2(T+1,H) :+: [1/22]:s2(T+1,H+1) :+: [1/22]:s2(T+1,H+2) :+: [1/22]:s2(T+1,H+3) :+: [1/22]:s2(T+1,H+4) :+: [1/22]:s2(T+1,H+5) :+: [1/22]:s2(T+1,H+6) :+: [1/22]:s2(T+1,H+7) :+: [1/22]:s2(T+1,H+8) :+: [1/22]:s2(T+1,H+9) :+: [1/22]:s2(T+1,H+10) :|: T-H>-1
    s2(T,H) -> s1(T,H)
  )
