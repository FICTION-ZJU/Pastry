(GOAL EXPECTEDCOMPLEXITY)
  (STARTTERM (FUNCTIONSYMBOLS s0))
  (VAR x y)
  (RULES
    s4(x,y) -> 0.5:s5(x,y) :+: 0.5:s6(x,y)
    s3(x,y) -> s4(x,y) :|: (y + 1) > 0
    s5(x,y) -> s3(x,y - 1)
    s6(x,y) -> s3(x,y)
    s3(x,y) -> s7(x,y) :|: 1>y + 1
    s9(x,y) -> 0.5:s10(x,y) :+: 0.5:s11(x,y)
    s8(x,y) -> s9(x,y) :|: y < 3
    s10(x,y) -> s8(x,y + 1)
    s11(x,y) -> s8(x,y)
    s7(x,y) -> s8(x - 1,y)
    s2(x,y) -> 0.5:s3(x,y) :+: 0.5:s12(x,y)
    s1(x,y) -> s2(x,y) :|: (x + 1) > 0
    s8(x,y) -> s1(x,y) :|: 2<y
    s12(x,y) -> s1(x,y)
    s0(x,y) -> s1(2,2)
  )
