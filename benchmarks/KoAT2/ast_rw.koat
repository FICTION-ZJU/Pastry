(GOAL EXPECTEDCOMPLEXITY)
  (STARTTERM (FUNCTIONSYMBOLS s0))
  (VAR x)
  (RULES
    s6(x) -> 0.5:s7(x) :+: 0.5:s8(x)
    s4(x) -> [1/3]:s5(x) :+: [2/3]:s6(x)
    s2(x) -> 0.25:s3(x) :+: 0.75:s4(x)
    s1(x) -> s2(x) :|: x >= 0
    s3(x) -> s1(x - 2)
    s5(x) -> s1(x - 1)
    s7(x) -> s1(x + 0)
    s8(x) -> s1(x + 1)
    s0(x) -> s1(100)
  )
